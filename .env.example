# AI Provider Configuration
# Set the default backend provider (gemini, openai, ollama, sambanova)
AI_PROVIDER=

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI & OpenAI-Compatible Endpoints
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# NVIDIA NIM (OpenAI-compatible)
# For NVIDIA NIM models (e.g. deepseek-ai/deepseek-v4.1-flash, nvidia/nemotron-3.5-lightning-30b-a3b)
# Provide your NVIDIA NIM API key here (or as OPENAI_API_KEY with OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1)
NVIDIA_API_KEY=

# SambaNova Cloud
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=
SAMBANOVA_MODEL=

# Ollama (Local)
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Anthropic Claude (Planned / Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Server Configuration
PORT=5000
WORKSPACE_ROOT=./storage/workspaces
AI_TIMEOUT_MS=300000
